{
  "$id": "https://garmentcad.local/schemas/revision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "author": {
      "title": "Author",
      "type": "string"
    },
    "change_set_id": {
      "title": "Change Set Id",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "number": {
      "title": "Number",
      "type": "integer"
    },
    "parent": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent"
    },
    "reverse_of": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reverse Of"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "number",
    "parent",
    "change_set_id",
    "author",
    "message",
    "content_hash"
  ],
  "title": "Revision",
  "type": "object"
}
