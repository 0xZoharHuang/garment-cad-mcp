{
  "$id": "https://garmentcad.local/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "active_body": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Body"
    },
    "active_body_measurements": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Body Measurements"
    },
    "active_body_segmentation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Body Segmentation"
    },
    "active_camera_config": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Camera Config"
    },
    "active_fabric": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Fabric"
    },
    "active_simulation_config": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Simulation Config"
    },
    "assembly_file": {
      "default": "assembly/main.garmentcode.json",
      "title": "Assembly File",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_revision": {
      "default": 0,
      "title": "Current Revision",
      "type": "integer"
    },
    "measurement_files": {
      "items": {
        "type": "string"
      },
      "title": "Measurement Files",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "pattern_file": {
      "default": "pattern/main.val",
      "title": "Pattern File",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "units": {
      "const": "mm",
      "default": "mm",
      "title": "Units",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
