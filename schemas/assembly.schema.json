        "id": {
          "title": "Id",
          "type": "string"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "reverse_order": {
          "default": false,
          "title": "Reverse Order",
          "type": "boolean"
        },
        "right_wrong": {
          "default": false,
          "title": "Right Wrong",
          "type": "boolean"
        },
        "ruffle": {
          "default": 1.0,
          "exclusiveMinimum": 0,
