          "title": "Alias"
        },
        "curve": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curve"
        },
        "end": {
          "title": "End",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "start": {
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "AssemblyEdge",
      "type": "object"
    },
    "AssemblyInterface": {
