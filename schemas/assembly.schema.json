            "same",
            "opposed",
            "auto"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "interface_a": {
          "title": "Interface A",
          "type": "string"
        },
        "interface_b": {
          "title": "Interface B",
          "type": "string"
        }
      },
      "required": [
        "id",
        "alias",
        "interface_a",
        "interface_b"
      ],
      "title": "AssemblyStitch",
      "type": "object"
    }
