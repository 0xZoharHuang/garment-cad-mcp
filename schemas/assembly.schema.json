              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Deg",
          "type": "array"
        },
        "seam_allowance_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seam Allowance Mm"
        },
        "translation_mm": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translation Mm",
          "type": "array"
        },
        "vertices_mm": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
