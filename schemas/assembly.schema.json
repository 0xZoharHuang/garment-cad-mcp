  "$id": "https://garmentcad.local/schemas/assembly.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "components": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
