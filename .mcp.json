{
  "mcpServers": {
    "valentina-cad": {
      "command": "uv",
      "args": ["--directory", "${CLAUDE_PROJECT_DIR}", "run", "valentina-mcp"],
      "env": {
        "GARMENTCAD_VALENTINA_COMMAND": "${CLAUDE_PROJECT_DIR}/build/valentina-command/garmentcad-valentina-command"
      }
    },
    "garmentcode-cad": {
      "command": "uv",
      "args": ["--directory", "${CLAUDE_PROJECT_DIR}", "run", "garmentcode-mcp"]
    }
  }
}
